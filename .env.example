# Tablescope deployment environment variables.
# Copy this file to .env and fill in values before running docker compose up.

# --- Platform API ---
ENVIRONMENT=production
LOG_LEVEL=INFO
JWT_SECRET_KEY=please-change-me
JWT_ISSUER=tablescope-platform-api
JWT_AUDIENCE=tablescope-clients
# Comma-separated API keys for service-to-service callers.
SERVICE_API_KEYS=

# --- Postgres ---
POSTGRES_PASSWORD=tablescope
# Optional role-split URLs. Leave blank until dedicated non-owner app/worker
# and migrator roles are provisioned; docker-compose keeps the legacy default.
PLATFORM_DATABASE_URL=
MIGRATION_DATABASE_URL=
# Keep false until the TS-ISO-004 role split, worker audit, and canary table
# preflight are complete. The Alembic migration installs disabled policies.
POSTGRES_RLS_CONTEXT_ENABLED=false

# --- WildFly / Teiid (host) ---
TEIID_PG_HOST=host.docker.internal
TEIID_PG_PORT=35442
TEIID_PG_USER=test
TEIID_PG_PASSWORD=test
TEIID_PG_DEFAULT_VDB=myvdbtest
TEIID_SERVLET_URL=http://host.docker.internal:8095
TEIID_API_KEY=

# --- Third-party auth ---
CLERK_JWKS_URL=
CLERK_ISSUER=
SUPABASE_JWKS_URL=
SUPABASE_ISSUER=

# --- Observability ---
SENTRY_DSN=

# --- Web UI ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
