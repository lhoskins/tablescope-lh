# Tablescope deployment environment variables.
# Copy this file to .env and fill in values before running docker compose up.

# --- Platform API ---
ENVIRONMENT=production
LOG_LEVEL=INFO
JWT_SECRET_KEY=please-change-me
JWT_ISSUER=tablescope-platform-api
JWT_AUDIENCE=tablescope-clients
# Comma-separated API keys for service-to-service callers.
SERVICE_API_KEYS=

# --- Postgres ---
POSTGRES_PASSWORD=tablescope

# --- WildFly / Teiid (host) ---
TEIID_PG_HOST=host.docker.internal
TEIID_PG_PORT=35442
TEIID_PG_USER=test
TEIID_PG_PASSWORD=test
TEIID_PG_DEFAULT_VDB=myvdbtest
TEIID_SERVLET_URL=http://host.docker.internal:8095
TEIID_API_KEY=

# --- Third-party auth ---
CLERK_JWKS_URL=
CLERK_ISSUER=
SUPABASE_JWKS_URL=
SUPABASE_ISSUER=

# --- Observability ---
SENTRY_DSN=

# --- Google Drive Spreadsheet connector ---
# One shared Tablescope OAuth client (Google Cloud Console > APIs & Services
# > Credentials). GOOGLE_DRIVE_REDIRECT_URI must exactly match an "Authorized
# redirect URI" registered on that client AND the URL this deployment's
# web-ui actually serves /connector-callbacks/google at, or Google either
# rejects the request outright or sends the browser back to a dead URL after
# consent. Defaults to APP_BASE_URL + /connector-callbacks/google if unset.
GOOGLE_DRIVE_CONNECTOR_V1_ENABLED=false
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=

# --- Web UI ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
