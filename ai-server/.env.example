# Tablescope AI Server configuration
OLLAMA_URL=http://ollama:11434
OLLAMA_MAX_CONCURRENT=4
TENANT_MAX_CONCURRENT=3
AI_GATE_ACQUIRE_TIMEOUT_SECONDS=30
AI_PLAN_RESERVED_GLOBAL_SLOTS=1
AI_PLAN_RESERVED_TENANT_SLOTS=1
AI_PLAN_GATE_ACQUIRE_TIMEOUT_SECONDS=5
AI_GATE_RETRY_AFTER_SECONDS=5
QDRANT_URL=http://qdrant:6333
# Base URL of the Tablescope platform-api. Must be reachable from the AI server.
# Use the public HTTPS endpoint (proxied by nginx) — the raw :8000 port is
# firewalled off, so pointing here at http://<host>:8000 will silently fail.
TABLESCOPE_APP_URL=https://app.tablescope.cloud
AI_SIGNING_SECRET=change-me-generate-with-openssl-rand-hex-32
IDLE_TIMEOUT_MINUTES=60
DATA_MOUNT=/mnt/tablescope-ai
