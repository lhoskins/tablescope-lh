# Platform API environment template. Copy to .env and fill in.

# Core
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PREFIX=/api

# Database (PostgreSQL metadata)
DATABASE_URL=postgresql+asyncpg://postgres:password@db:5432/tablescope
DATABASE_POOL_MIN_SIZE=5
DATABASE_POOL_MAX_SIZE=20

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET_KEY=change-me-please
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_TTL_MINUTES=60
JWT_ISSUER=tablescope-platform-api
JWT_AUDIENCE=tablescope-clients

# Service-to-service API keys (comma separated)
SERVICE_API_KEYS=

# Teiid / WildFly servlet integration
TEIID_PG_HOST=teiid
TEIID_PG_PORT=35442
TEIID_PG_DEFAULT_VDB=myvdbtest
TEIID_SERVLET_URL=http://teiid:8095
TEIID_SERVLET_API_KEY=change-me-too

# Customer / VDB filesystem
CUSTOMER_BASE_PATH=/opt/wildfly/teiidfiles/customers
DRILLDOWN_CONFIG_PATH=/opt/redash-8.0.0-7/apps/tsTest/src/drilldownConfig.json

# Auth providers (optional)
CLERK_JWKS_URL=
CLERK_ISSUER=
SUPABASE_JWKS_URL=
SUPABASE_ISSUER=

# --- Supabase Authentication (single env-configured provider) ---
# APP_ENV is an accepted alias for ENVIRONMENT above.
SUPABASE_ENV=test
SUPABASE_URL=https://jytfewjraajqkacisyqo.supabase.co
SUPABASE_PROJECT_REF=jytfewjraajqkacisyqo
SUPABASE_ANON_KEY=
# Backend-only — DO NOT expose to the frontend or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string for Supabase (URL-encode the password if needed).
SUPABASE_DATABASE_URL=
# Only needed if verifying HS256 Supabase JWTs locally.
SUPABASE_JWT_SECRET=

# --- Stripe Billing ---
STRIPE_MODE=test
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Set after creating the webhook in the Stripe dashboard (whsec_...).
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=https://app.tablescope.cloud/billing/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=https://app.tablescope.cloud/pricing

# Observability
SENTRY_DSN=
PROMETHEUS_ENABLED=true
