<?xml version="1.0" encoding="UTF-8"?>
<module name="org.jboss.teiid" xmlns="urn:jboss:module:1.3">
    <properties>
        <property name="jboss.api" value="UNSUPPORTED"/>
    </properties>
    
    <resources>
        <resource-root path="teiid-engine-16.0.0.jar"/>
        <resource-root path="saxon-xom-16.0.0.jar"/>
        <resource-root path="cache-infinispan-16.0.0.jar"/>
        <resource-root path="teiid-wildfly-integration-16.0.0.jar"/>
        <resource-root path="teiid-metadata-16.0.0.jar"/>
        <resource-root path="teiid-runtime-16.0.0.jar"/>
        <resource-root path="teiid-wildfly-admin-16.0.0.jar"/>
        <resource-root path="teiid-data-quality-16.0.0.jar"/>
        <resource-root path="teiid-optional-geo-16.0.0.jar"/>
        <resource-root path="teiid-optional-xml-16.0.0.jar"/>
        <resource-root path="teiid-optional-json-16.0.0.jar"/>
        <resource-root path="deployments"/>
    </resources>

    <dependencies>
        <module name="javax.api"/>
        <module name="javax.resource.api"/>         
        <module name="sun.jdk" optional="true"/> <!-- Kerberos -->          
        <module name="org.jboss.teiid.common-core"/>
        <module name="org.jboss.teiid.api"/>
        <module name="org.jboss.teiid.client"/>
        <module name="org.jboss.logging"/>
        <module name="org.jboss.modules"/>
        <module name="org.jboss.msc"/>
        <module name="io.netty"/>
        <module name="org.jboss.staxmapper"/>
        <module name="org.jboss.vfs"/>
        <module name="org.picketbox"/>
        <module name="org.jboss.as.network"/>
        <module name="org.jboss.as.security"/>
        <module name="org.jboss.as.server"/>        
        <module name="org.jboss.as.naming"/>
        <module name="org.jboss.security.negotiation"/> <!-- SPNEGO -->
        <module name="javax.xml.bind.api"/>
        <module name="javax.transaction.api"/>
        <module name="javax.activation.api"/>
        <module name="org.jboss.as.clustering.jgroups"/>
        <module name="org.infinispan"/>
        <module name="org.arrahtec"/>
        
        <module name="org.jboss.marshalling"/>
        <module name="org.jboss.marshalling.river"/> 
        <module name="org.jboss.as.ee"/>
        <module name="org.jboss.metadata.common"/> 
        <module name="org.wildfly.clustering.jgroups.api"/>
        <module name="org.wildfly.clustering.jgroups.spi"/>
        <module name="org.wildfly.clustering.infinispan.spi"/>
        
        <module name="org.jboss.as.connector"/>
        <module name="org.jboss.ironjacamar.api"/>
        <module name="org.jboss.ironjacamar.impl"/>
        <module name="org.jgroups"/>
        <module name="nu.xom"/>
        <module name="net.sf.saxon"/>
        
        <!-- geo -->
        <module name="org.locationtech.jts"/>
        <module name="org.osgeo.proj4j"/>
        <module name="org.wololo.jts2geojson"/>
        
        <!-- json -->
        <module name="com.jayway.jsonpath"/>
        
        <module name="org.jboss.dmr"/> <!-- Admin -->        
        <module name="org.jboss.as.cli"/> <!-- Admin -->
        <module name="org.jboss.as.controller-client"/> <!-- Admin -->
        <module name="org.jboss.as.controller"/> <!-- Admin -->
        
        <module name="io.opentracing.opentracing-api"/>
        <module name="io.opentracing.opentracing-noop"/>
        <module name="io.opentracing.opentracing-util"/>
        <module name="io.opentracing.contrib.opentracing-concurrent"/>
    </dependencies>
</module>
