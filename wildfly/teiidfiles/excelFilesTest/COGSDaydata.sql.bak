CREATE TABLE IF NOT EXISTS COGSDay (
    `Root_Job` VARCHAR(10) CHARACTER SET utf8,
    `Job` VARCHAR(10) CHARACTER SET utf8,
    `Position` INT,
    `Type` VARCHAR(8) CHARACTER SET utf8,
    `Assembly_Lvl` INT,
    `Customer` VARCHAR(8) CHARACTER SET utf8,
    `Part` VARCHAR(100) CHARACTER SET utf8,
    `Description` VARCHAR(30) CHARACTER SET utf8,
    `Rev` INT,
    `Status` VARCHAR(1) CHARACTER SET utf8,
    `Order_Qty` INT,
    `Make_Qty` INT,
    `Produced_Qty` INT,
    `Ship_Qty` INT,
    `Trans_Qty` INT,
    `Scrap_Qty` INT,
    `Pick_Qty` INT,
    `Lab` NUMERIC(9, 4),
    `WIpLab` NUMERIC(8, 4),
    `COGSLab` NUMERIC(9, 4),
    `TransLab` NUMERIC(8, 4),
    `ScrapLab` NUMERIC(8, 4),
    `Burd` NUMERIC(9, 4),
    `WipBurd` NUMERIC(9, 4),
    `COGSBurd` NUMERIC(9, 4),
    `TransBurd` NUMERIC(8, 4),
    `ScrapBurd` NUMERIC(8, 4),
    `Mat` NUMERIC(7, 2),
    `WipMat` NUMERIC(7, 2),
    `COGSMat` NUMERIC(7, 2),
    `TransMat` NUMERIC(7, 2),
    `ScrapMat` NUMERIC(6, 2),
    `Serv` NUMERIC(7, 2),
    `WipServ` NUMERIC(8, 4),
    `COGSServ` NUMERIC(9, 4),
    `TransServ` NUMERIC(7, 4),
    `ScrapServ` NUMERIC(8, 4),
    `Total` NUMERIC(9, 4),
    `WipTotal` NUMERIC(9, 4),
    `COGSTotal` NUMERIC(9, 4),
    `TransTotal` NUMERIC(8, 4),
    `ScrapTotal` NUMERIC(8, 4),
    `COGSProfit` NUMERIC(10, 4),
    `WipMrkt` INT,
    `LowerCostorMrktt` INT,
    `LowerCostofMrktAdjt` INT,
    `Act_Rev` NUMERIC(8, 2),
    `Sales_Rep` VARCHAR(6) CHARACTER SET utf8,
    `Sales_Code` VARCHAR(13) CHARACTER SET utf8,
    `Order_Date` INT,
    `Status_Date` NUMERIC(10, 5),
    `Unit_Price` NUMERIC(7, 2),
    `Price_UofM` VARCHAR(3) CHARACTER SET utf8,
    `Order_Unit` VARCHAR(4) CHARACTER SET utf8,
    `Unit_Conv` INT,
    `Hrs` NUMERIC(6, 2),
    `WipHrs` NUMERIC(18, 15),
    `CogsHrs` NUMERIC(19, 15),
    `TransHrs` NUMERIC(11, 9),
    `ScrapHrs` NUMERIC(12, 9),
    `Std_Cost` NUMERIC(8, 4),
    `Avg_Cost` NUMERIC(8, 4),
    `Last_Cost` NUMERIC(8, 4),
    `Sell_Price` NUMERIC(4, 2),
    `Cust_PO` VARCHAR(15) CHARACTER SET utf8,
    `QPer` INT,
    `Relationship_Qty` INT,
    `BuildToStock` INT,
    `TimeAndMat` INT,
    `LBurd` NUMERIC(8, 4),
    `LWipBurd` NUMERIC(8, 4),
    `LCOGSBurd` NUMERIC(8, 4),
    `LTransBurd` NUMERIC(7, 4),
    `LScrapBurd` NUMERIC(8, 4),
    `MBurd` NUMERIC(8, 4),
    `MWipBurd` NUMERIC(8, 4),
    `MCOGSBurd` NUMERIC(8, 4),
    `MTransBurd` NUMERIC(8, 4),
    `MScrapBurd` NUMERIC(8, 4),
    `GBurd` NUMERIC(9,4),
    `GWipBurd` NUMERIC(9, 4),
    `GCOGSBurd` NUMERIC(9, 4),
    `GTransBurd` NUMERIC(8, 4),
    `GScrapBurd` NUMERIC(8, 4),
    `Period` DATETIME,
    `COGSID` int(10) AUTO_INCREMENT PRIMARY KEY

);
