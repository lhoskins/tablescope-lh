    <metadata type="DDL">
      <![CDATA[
        CREATE VIEW MyCSV (
          username string(4000) OPTIONS(NAMEINSOURCE 'username', UPDATABLE 'FALSE'),
          password string(4000) OPTIONS(NAMEINSOURCE 'password', UPDATABLE 'FALSE'),
          firstname string(4000) OPTIONS(NAMEINSOURCE 'firstname', UPDATABLE 'FALSE'),
          lastname string(4000) OPTIONS(NAMEINSOURCE 'lastname', UPDATABLE 'FALSE'),
          email string(4000) OPTIONS(NAMEINSOURCE 'email', UPDATABLE 'FALSE'),
          course1 string(4000) OPTIONS(NAMEINSOURCE 'course1', UPDATABLE 'FALSE'),
          group1 string(4000) OPTIONS(NAMEINSOURCE 'group1', UPDATABLE 'FALSE')
        ) 
        AS
          SELECT 
            A.username, A.password, A.firstname, A.lastname, A.email, A.course1, A.group1
          FROM
            (EXEC CSVSourceModel.getTextFiles('upload_users.csv')) AS f,
            TEXTTABLE(f.file COLUMNS username string, password string, firstname string, lastname string, email string, course1 string, group1 string HEADER) AS A;
 
         CREATE VIEW MyText_TXT (
          OrderID string(4000) OPTIONS(NAMEINSOURCE 'OrderID', UPDATABLE 'FALSE'),
          CustomerID string(4000) OPTIONS(NAMEINSOURCE 'CustomerID', UPDATABLE 'FALSE'),
          ProductID string(4000) OPTIONS(NAMEINSOURCE 'ProductID', UPDATABLE 'FALSE'),
          Quantity string(4000) OPTIONS(NAMEINSOURCE 'Quantity', UPDATABLE 'FALSE'),
          Price string(4000) OPTIONS(NAMEINSOURCE 'Price', UPDATABLE 'FALSE'),
          OrderDate string(4000) OPTIONS(NAMEINSOURCE 'OrderDate', UPDATABLE 'FALSE')
        ) 
        AS
          SELECT 
		A.OrderID, A.CustomerID, A.ProductID, A.Quantity, A.Price, A.OrderDate
	FROM
		(EXEC CSVSourceModel.getTextFiles('*.*')) AS f, TEXTTABLE(file COLUMNS OrderID string, CustomerID string, ProductID string, Quantity string, Price string, OrderDate string  DELIMITER '	' HEADER) AS A

CREATE VIEW GLDump2019YTD_XLSX AS SELECT * FROM ExcelSourceModel.GLDump2019YTD;;
CREATE VIEW SalesJournalYTD_XLSX AS SELECT * FROM ExcelSourceModel.SalesJournalYTD;;

CREATE VIEW SalesRoller AS SELECT SalesJournalYTD_XLSX.Date_, SalesJournalYTD_XLSX.Customer_ID, SalesJournalYTD_XLSX.Name, SalesJournalYTD_XLSX.Job_ID, GLDump2019YTD_XLSX.GL, GLDump2019YTD_XLSX.Dept FROM SalesJournalYTD_XLSX LEFT JOIN GLDump2019YTD_XLSX ON SalesJournalYTD_XLSX.Job_ID = GLDump2019YTD_XLSX.Job_ID;
CREATE VIEW SalesJournalYTD2_XLSX AS SELECT * FROM ExcelSourceModel.SalesJournalYTD2;;
CREATE VIEW EPHRAIM AS 
SELECT 
    SalesRoller.Date_,
    SalesRoller.Customer_ID,
    SalesRoller.Job_ID,
    SalesRoller.GL,
    SalesRoller.Dept,
	InvoiceCM_No
   
FROM 
    SalesRoller LEFT JOIN SalesJournalYTD_XLSX ON SalesRoller.Job_ID = SalesJournalYTD_XLSX.Job_ID;
CREATE VIEW SalesJournalYTD3_XLSX AS SELECT * FROM ExcelSourceModel.SalesJournalYTD3;;
CREATE VIEW V3iTProspectsList_XLSX AS SELECT * FROM ExcelSourceModel.V3iTProspectsList;;
