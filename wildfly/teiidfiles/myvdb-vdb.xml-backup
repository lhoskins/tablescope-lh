    <!-- Visible model for the MyView -->
    <model name="MyCompany" type="VIRTUAL" visible="true">
        <metadata type="DDL">
            <![CDATA[ 
CREATE VIEW GLDump2019YTD_XLSX AS SELECT * FROM HiddenModel.GLDump2019YTD;;
CREATE VIEW SalesJournalYTD_XLSX AS SELECT * FROM HiddenModel.SalesJournalYTD;;

CREATE VIEW SalesRoller AS SELECT SalesJournalYTD_XLSX.Date_, SalesJournalYTD_XLSX.Customer_ID, SalesJournalYTD_XLSX.Name, SalesJournalYTD_XLSX.Job_ID, GLDump2019YTD_XLSX.GL, GLDump2019YTD_XLSX.Dept FROM SalesJournalYTD_XLSX LEFT JOIN GLDump2019YTD_XLSX ON SalesJournalYTD_XLSX.Job_ID = GLDump2019YTD_XLSX.Job_ID;
CREATE VIEW SalesJournalYTD2_XLSX AS SELECT * FROM HiddenModel.SalesJournalYTD2;;
CREATE VIEW EPHRAIM AS 
SELECT 
    SalesRoller.Date_,
    SalesRoller.Customer_ID,
    SalesRoller.Job_ID,
    SalesRoller.GL,
    SalesRoller.Dept,
	InvoiceCM_No
   
FROM 
    SalesRoller LEFT JOIN SalesJournalYTD_XLSX ON SalesRoller.Job_ID = SalesJournalYTD_XLSX.Job_ID;
CREATE VIEW SalesJournalYTD3_XLSX AS SELECT * FROM HiddenModel.SalesJournalYTD3;;
CREATE VIEW V3iTProspectsList_XLSX AS SELECT * FROM HiddenModel.V3iTProspectsList;;
CREATE VIEW ActivatedUsers2_XLSX AS SELECT * FROM HiddenModel.ActivatedUsers2;;
CREATE VIEW upload_users_CSV AS SELECT * FROM HiddenModel.upload_users;;
-- Place new View above



			]]> 
