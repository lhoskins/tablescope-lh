        <metadata type="DDL">
            <![CDATA[ -- Place Foreign Table Below
-- CSV Foreign Table
CREATE FOREIGN TABLE  upload_users(
	ROW_ID integer OPTIONS (SEARCHABLE 'All_Except_Like', "teiid_csv:ROW_NUMBER" 'ROW_ID'),
	username string,
	password string,
	firstname string,
	lastname string,
	email string,
	course1 string,
	group1 string 
  )
  OPTIONS(
	"teiid_csv:FILE" 'upload_users.csv',
	"teiid_csv:SKIP_HEADER_COUNT" '1'  
  );        


CREATE FOREIGN TABLE ActivatedUsers2(
	ROW_ID integer OPTIONS (SEARCHABLE 'All_Except_Like', "teiid_excel:CELL_NUMBER" 'ROW_ID'),
	Test string OPTIONS (SEARCHABLE 'Unsearchable', "teiid_excel:CELL_NUMBER" '1'),
	Users string OPTIONS (SEARCHABLE 'Unsearchable', "teiid_excel:CELL_NUMBER" '2'),
	Companies string OPTIONS (SEARCHABLE 'Unsearchable', "teiid_excel:CELL_NUMBER" '3'),
	CONSTRAINT PK0 PRIMARY KEY(ROW_ID)
) OPTIONS ("NAMEINSOURCE" 'Sheet1', "teiid_excel:FILE" 'ActivatedUsers2.xlsx', "teiid_excel:FIRST_DATA_ROW_NUMBER" '2');

