<vdb name="MyVDBTest" version="1">
  
  <!-- Enable Teiid Result Set Caching for Performance -->
  <property name="result-set-cache-mode" value="true"/>
  <property name="result-set-cache-max-age" value="1800"/> <!-- 30 minutes -->
  
  <!-- Hidden model for the Activate foreign table -->
  <model name="ExcelSourceModel" type="PHYSICAL" visible="false">
    <source name="excel-connector" translator-name="excel" connection-jndi-name="java:/excelTestDS"/>
    <metadata type="DDL">
      <![CDATA[ -- Place Foreign Table Below
CREATE FOREIGN TABLE purchaseorderheader(
	ROW_ID integer OPTIONS (SEARCHABLE 'All_Except_Like', "teiid_excel:CELL_NUMBER" 'ROW_ID'),
	PurchaseOrderID string OPTIONS (SEARCHABLE 'Unsearchable', "teiid_excel:CELL_NUMBER" '1'),
	RevisionNumber string OPTIONS (SEARCHABLE 'Unsearchable', "teiid_excel:CELL_NUMBER" '2'),
	Status string OPTIONS (SEARCHABLE 'Unsearchable', "teiid_excel:CELL_NUMBER" '3'),
	EmployeeID string OPTIONS (SEARCHABLE 'Unsearchable', "teiid_excel:CELL_NUMBER" '4'),
	VendorID string OPTIONS (SEARCHABLE 'Unsearchable', "teiid_excel:CELL_NUMBER" '5'),
	ShipMethodID string OPTIONS (SEARCHABLE 'Unsearchable', "teiid_excel:CELL_NUMBER" '6'),
	OrderDate string OPTIONS (SEARCHABLE 'Unsearchable', "teiid_excel:CELL_NUMBER" '7'),
	ShipDate string OPTIONS (SEARCHABLE 'Unsearchable', "teiid_excel:CELL_NUMBER" '8'),
	SubTotal string OPTIONS (SEARCHABLE 'Unsearchable', "teiid_excel:CELL_NUMBER" '9'),
	TaxAmt string OPTIONS (SEARCHABLE 'Unsearchable', "teiid_excel:CELL_NUMBER" '10'),
	Freight string OPTIONS (SEARCHABLE 'Unsearchable', "teiid_excel:CELL_NUMBER" '11'),
	TotalDue string OPTIONS (SEARCHABLE 'Unsearchable', "teiid_excel:CELL_NUMBER" '12'),
	ModifiedDate string OPTIONS (SEARCHABLE 'Unsearchable', "teiid_excel:CELL_NUMBER" '13'),
	CONSTRAINT PK0 PRIMARY KEY(ROW_ID)
) OPTIONS ("NAMEINSOURCE" 'result', "teiid_excel:FILE" 'purchaseorderheader.xlsx', "teiid_excel:FIRST_DATA_ROW_NUMBER" '2');

CREATE FOREIGN TABLE productmodel(
	ROW_ID integer OPTIONS (SEARCHABLE 'All_Except_Like', "teiid_excel:CELL_NUMBER" 'ROW_ID'),
	ProductModelID string OPTIONS (SEARCHABLE 'Unsearchable', "teiid_excel:CELL_NUMBER" '1'),
	Name string OPTIONS (SEARCHABLE 'Unsearchable', "teiid_excel:CELL_NUMBER" '2'),
	CatalogDescription string OPTIONS (SEARCHABLE 'Unsearchable', "teiid_excel:CELL_NUMBER" '3'),
	Instructions string OPTIONS (SEARCHABLE 'Unsearchable', "teiid_excel:CELL_NUMBER" '4'),
	ModifiedDate string OPTIONS (SEARCHABLE 'Unsearchable', "teiid_excel:CELL_NUMBER" '5'),
	CONSTRAINT PK0 PRIMARY KEY(ROW_ID)
) OPTIONS ("NAMEINSOURCE" 'result', "teiid_excel:FILE" 'productmodel.xlsx', "teiid_excel:FIRST_DATA_ROW_NUMBER" '2');

