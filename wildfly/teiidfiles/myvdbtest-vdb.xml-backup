  <model name="CSVSourceModel" type="PHYSICAL" visible="false">
    <source name="text-connector" translator-name="file" connection-jndi-name="java:/fileTestDS" />
    <metadata type="DDL">
      <![CDATA[
        CREATE FOREIGN PROCEDURE getTextFiles (
          IN pathAndExt string(4000) NOT NULL
        ) RETURNS
          TABLE (
            file clob,
            filePath string(4000),
            lastModified timestamp,
            created timestamp,
            size integer
          ) OPTIONS(UPDATECOUNT '1');
      ]]>
    </metadata>
  </model>

  <!-- Visible model for the MyView -->
  <model name="MyCompany" type="VIRTUAL" visible="true">
    <metadata type="DDL">
      <![CDATA[
 
;

CREATE VIEW ActivatedUsers2_XLSX AS SELECT Test, Users, Companies FROM ExcelSourceModel.ActivatedUsers2;;

CREATE VIEW SalesJournal2025_XLSX AS SELECT Date_, Customer_ID, Name, Job_ID, Job_Description, Account_ID, Account_Description, InvoiceCM_No, Line_Description, Purchase_Order_No, Amount FROM ExcelSourceModel.SalesJournal2025;;

CREATE VIEW COGSDate_XLS AS SELECT Root_Job, Job, Position, Type, Assembly_Lvl, Customer, Part, Description, Rev, Status, Order_Qty, Make_Qty, Produced_Qty, Ship_Qty, Trans_Qty, Scrap_Qty, Pick_Qty, Lab, WIpLab, COGSLab, TransLab, ScrapLab, Burd, WipBurd, COGSBurd, TransBurd, ScrapBurd, Mat, WipMat, COGSMat, TransMat, ScrapMat, Serv, WipServ, COGSServ, TransServ, ScrapServ, Total, WipTotal, COGSTotal, TransTotal, ScrapTotal, COGSProfit, WipMrkt, LowerCostorMrktt, LowerCostofMrktAdjt, Act_Rev, Sales_Rep, Sales_Code, Order_Date, Status_Date, Unit_Price, Price_UofM, Order_Unit, Unit_Conv, Hrs, WipHrs, CogsHrs, TransHrs, ScrapHrs, Std_Cost, Avg_Cost, Last_Cost, Sell_Price, Cust_PO, QPer, Relationship_Qty, BuildToStock, TimeAndMat, LBurd, LWipBurd, LCOGSBurd, LTransBurd, LScrapBurd, MBurd, MWipBurd, MCOGSBurd, MTransBurd, MScrapBurd, GBurd, GWipBurd, GCOGSBurd, GTransBurd, GScrapBurd FROM ExcelSourceModel.COGSDate;;

CREATE VIEW SALES_TXT (
OrderID string(4000) OPTIONS(NAMEINSOURCE 'OrderID', UPDATABLE 'FALSE'),
CustomerID string(4000) OPTIONS(NAMEINSOURCE 'CustomerID', UPDATABLE 'FALSE'),
ProductID string(4000) OPTIONS(NAMEINSOURCE 'ProductID', UPDATABLE 'FALSE'),
Quantity string(4000) OPTIONS(NAMEINSOURCE 'Quantity', UPDATABLE 'FALSE'),
Price string(4000) OPTIONS(NAMEINSOURCE 'Price', UPDATABLE 'FALSE'),
OrderDate string(4000) OPTIONS(NAMEINSOURCE 'OrderDate', UPDATABLE 'FALSE')
) AS
SELECT 
A.OrderID, A.CustomerID, A.ProductID, A.Quantity, A.Price, A.OrderDate
FROM
(EXEC CSVSourceModel.getTextFiles('sales.txt')) AS f,
TEXTTABLE(f.file COLUMNS OrderID string, CustomerID string, ProductID string, Quantity string, Price string, OrderDate string DELIMITER '	' HEADER) AS A;

CREATE VIEW productmodel_XLSX AS SELECT ProductModelID, Name, CatalogDescription, Instructions, ModifiedDate FROM ExcelSourceModel.productmodel;;

CREATE VIEW purchaseorderheader_XLSX AS SELECT PurchaseOrderID, RevisionNumber, Status, EmployeeID, VendorID, ShipMethodID, OrderDate, ShipDate, SubTotal, TaxAmt, Freight, TotalDue, ModifiedDate FROM ExcelSourceModel.purchaseorderheader;;

CREATE VIEW SALESORDERDETAIL_CSV (
SalesOrderID string(4000) OPTIONS(NAMEINSOURCE 'SalesOrderID', UPDATABLE 'FALSE'),
SalesOrderDetailID string(4000) OPTIONS(NAMEINSOURCE 'SalesOrderDetailID', UPDATABLE 'FALSE'),
CarrierTrackingNumber string(4000) OPTIONS(NAMEINSOURCE 'CarrierTrackingNumber', UPDATABLE 'FALSE'),
OrderQty string(4000) OPTIONS(NAMEINSOURCE 'OrderQty', UPDATABLE 'FALSE'),
ProductID string(4000) OPTIONS(NAMEINSOURCE 'ProductID', UPDATABLE 'FALSE'),
SpecialOfferID string(4000) OPTIONS(NAMEINSOURCE 'SpecialOfferID', UPDATABLE 'FALSE'),
UnitPrice string(4000) OPTIONS(NAMEINSOURCE 'UnitPrice', UPDATABLE 'FALSE'),
UnitPriceDiscount string(4000) OPTIONS(NAMEINSOURCE 'UnitPriceDiscount', UPDATABLE 'FALSE'),
LineTotal string(4000) OPTIONS(NAMEINSOURCE 'LineTotal', UPDATABLE 'FALSE'),
ModifiedDate string(4000) OPTIONS(NAMEINSOURCE 'ModifiedDate', UPDATABLE 'FALSE')
) AS
SELECT 
A.SalesOrderID, A.SalesOrderDetailID, A.CarrierTrackingNumber, A.OrderQty, A.ProductID, A.SpecialOfferID, A.UnitPrice, A.UnitPriceDiscount, A.LineTotal, A.ModifiedDate
FROM
(EXEC CSVSourceModel.getTextFiles('salesorderdetail.csv')) AS f,
TEXTTABLE(f.file COLUMNS SalesOrderID string, SalesOrderDetailID string, CarrierTrackingNumber string, OrderQty string, ProductID string, SpecialOfferID string, UnitPrice string, UnitPriceDiscount string, LineTotal string, ModifiedDate string DELIMITER ',' HEADER) AS A;

CREATE VIEW UPLOAD_USERS_CSV (
username string(4000) OPTIONS(NAMEINSOURCE 'username', UPDATABLE 'FALSE'),
password string(4000) OPTIONS(NAMEINSOURCE 'password', UPDATABLE 'FALSE'),
firstname string(4000) OPTIONS(NAMEINSOURCE 'firstname', UPDATABLE 'FALSE'),
lastname string(4000) OPTIONS(NAMEINSOURCE 'lastname', UPDATABLE 'FALSE'),
email string(4000) OPTIONS(NAMEINSOURCE 'email', UPDATABLE 'FALSE'),
course1 string(4000) OPTIONS(NAMEINSOURCE 'course1', UPDATABLE 'FALSE'),
group1 string(4000) OPTIONS(NAMEINSOURCE 'group1', UPDATABLE 'FALSE')
) AS
SELECT 
A.username, A.password, A.firstname, A.lastname, A.email, A.course1, A.group1
FROM
(EXEC CSVSourceModel.getTextFiles('upload_users.csv')) AS f,
TEXTTABLE(f.file COLUMNS username string, password string, firstname string, lastname string, email string, course1 string, group1 string DELIMITER ',' HEADER) AS A;

-- Place new View above

      ]]>
